class_name NpcFrames
extends RefCounted
## SpriteFrames for village NPCs (chief, fun, queen).
##
## Canvas: 256 x 192, feet on the bottom pad, node offset (0, -46).
## Walk strip: 8 columns, one row. Poses in order: contact, down, passing, up, twice.
## Idle strip: 4 columns, "{id}_{dir}_idle.png" beside the walk strip.
## Drawn directions: down, down_right, right, up_right, up.
## left, up_left and down_left use the east sheet plus flip_h.
##
## One crop and one scale per direction, shared by idle and walk, so the body
## does not pulse. The per-direction scale is stored as meta ("fit_<dir>") so
## NpcActor can turn real distance travelled into the exact walk frame.

const WALK_DIR := "res://assets/images/characters/npc_cycle/"
const IDLE_DIR := "res://assets/images/characters/npc_walk/"
const FRAME_W := 256
const FRAME_H := 192
const UNIQUE_DIRS := ["down", "down_right", "right", "up_right", "up"]
## Source px of ground covered by one full walk cycle. Default for any sheet not listed below.
const STRIDE_SRC_PX := 80.0
## Per "<sheet_id>_<dir>" override. Regenerated by the tools/ scripts, paste their output here.
const STRIDE_OVERRIDE := {"chief_down": 56.0, "fun_down": 56.0, "queen_down": 56.0}
const STRIDE_BY_SHEET := {
	"chief": 93.0,
	"fun": 83.0,
	"queen": 70.0,
}
## Only used for the fallback timer. Real walking is driven by distance.
const WALK_CYCLES_PER_SEC := 2.04
const IDLE_FPS := 4.0
const FOOT_PAD := 12
const MIN_WALK_FRAMES := 4
## Painted art: LANCZOS. Pixel art: Image.INTERPOLATE_NEAREST.
const RESIZE_MODE := Image.INTERPOLATE_LANCZOS
## Stopgap used only when a direction has no real walk strip.
const FALLBACK_BOB_PX := 3.0
const FALLBACK_FRAMES := 8


static var _cache: Dictionary = {}


static func load_or_build(sheet_id: String, walk_cycles := WALK_CYCLES_PER_SEC) -> SpriteFrames:
	if walk_cycles > 4.0:
		walk_cycles = WALK_CYCLES_PER_SEC
	var key := "fit-v11:%s:%.2f" % [sheet_id, walk_cycles]
	if _cache.has(key):
		return _cache[key] as SpriteFrames
	var frames := _build(sheet_id, walk_cycles)
	if not frames.get_animation_names().is_empty():
		_cache[key] = frames
	return frames


static func _build(sheet_id: String, walk_cycles: float) -> SpriteFrames:
	var frames := SpriteFrames.new()
	if sheet_id.is_empty():
		return frames
	var dir_idles: Dictionary = {}
	var dir_walks: Dictionary = {}
	var dir_real: Dictionary = {}
	var stature := 0
	for dir in UNIQUE_DIRS:
		var idle_imgs := _slice_images(WALK_DIR + sheet_id + "_" + dir + "_idle.png")
		if idle_imgs.size() < 2:
			idle_imgs = _slice_images(IDLE_DIR + sheet_id + "_" + dir + ".png")
			if idle_imgs.size() > 1:
				idle_imgs = [idle_imgs[0]]
		var walk_imgs := _slice_images(WALK_DIR + sheet_id + "_" + dir + ".png")
		if idle_imgs.is_empty() and walk_imgs.is_empty():
			continue
		if idle_imgs.is_empty():
			idle_imgs = [walk_imgs[0]]
		var painted := walk_imgs.size() >= MIN_WALK_FRAMES and _images_differ(walk_imgs)
		if not painted:
			push_warning("NpcFrames: %s_%s has no usable walk strip (%d frames). Using bob fallback; run tools/build_npc_walk_sheets.py" \
					% [sheet_id, dir, walk_imgs.size()])
			walk_imgs = _bob_walk(idle_imgs[0] as Image)
		dir_idles[dir] = idle_imgs
		dir_walks[dir] = walk_imgs
		dir_real[dir] = painted
		var h := _opaque_height(idle_imgs[0] as Image)
		if dir == "down_right":
			stature = h
		elif stature < 32:
			stature = maxi(stature, h)
	if stature < 32:
		stature = 161
	for dir in UNIQUE_DIRS:
		if not dir_idles.has(dir):
			continue
		var locked := _lock_direction(dir_idles[dir] as Array, dir_walks[dir] as Array, stature)
		var idle_cells: Array = locked["idle"]
		var walk_cells: Array = locked["walk"]
		if idle_cells.is_empty() or walk_cells.is_empty():
			continue
		var fit: float = locked["scale"]
		var fps := float(walk_cells.size()) * maxf(walk_cycles, 0.5)
		var idle_fps := IDLE_FPS if idle_cells.size() >= 4 else 1.0
		_add_anim(frames, "walk_" + dir, walk_cells, true, fps)
		_add_anim(frames, "idle_" + dir, idle_cells, true, idle_fps)
		frames.set_meta("fit_" + dir, fit)
		frames.set_meta("stride_" + dir, float(STRIDE_OVERRIDE.get(sheet_id + "_" + dir, STRIDE_SRC_PX)))
		frames.set_meta("real_" + dir, bool(dir_real.get(dir, false)))
		if dir == "right":
			_add_anim(frames, "walk_side", walk_cells, true, fps)
			_add_anim(frames, "idle_side", idle_cells, true, idle_fps)
	var stride: float = float(STRIDE_BY_SHEET.get(sheet_id, STRIDE_SRC_PX))
	frames.set_meta("stride_src", stride)
	return frames


static func _slice_images(path: String) -> Array:
	var src := Palette.read_image(path)
	if src == null or src.get_width() < FRAME_W:
		return []
	# Copy so we never modify a cached image, and force one pixel format.
	var image := Image.new()
	image.copy_from(src)
	if image.get_format() != Image.FORMAT_RGBA8:
		image.convert(Image.FORMAT_RGBA8)
	var count := 1
	if image.get_width() % FRAME_W == 0:
		count = int(image.get_width() / FRAME_W)
	elif image.get_width() > image.get_height():
		count = clampi(int(round(float(image.get_width()) / float(FRAME_W))), 2, 8)
		push_warning("NpcFrames: %s width %d is not a multiple of %d; guessed %d frames" \
				% [path, image.get_width(), FRAME_W, count])
	var cell_w := int(image.get_width() / float(count))
	if cell_w < 8:
		return []
	var cells: Array = []
	for i in count:
		cells.append(image.get_region(Rect2i(i * cell_w, 0, cell_w, image.get_height())))
	return cells


static func _images_differ(imgs: Array) -> bool:
	if imgs.size() < 2:
		return false
	var first := (imgs[0] as Image).get_data()
	for i in range(1, imgs.size()):
		if (imgs[i] as Image).get_data() != first:
			return true
	return false


## Stopgap walk: the idle pose lifted 0..FALLBACK_BOB_PX px, two bobs per cycle.
static func _bob_walk(idle: Image) -> Array:
	var out: Array = []
	var w := idle.get_width()
	var h := idle.get_height()
	for i in FALLBACK_FRAMES:
		var lift := int(round(absf(sin(TAU * float(i) / float(FALLBACK_FRAMES))) * FALLBACK_BOB_PX))
		var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
		img.fill(Color(0, 0, 0, 0))
		img.blit_rect(idle, Rect2i(0, 0, w, h), Vector2i(0, -lift))
		out.append(img)
	return out


## Median opaque x in the bottom of the figure. Placed on canvas x = 128 so flip_h cannot pop.
static func _feet_anchor_x(img: Image) -> float:
	var b := _opaque_bounds(img)
	if b.size.y < 1:
		return float(img.get_width()) * 0.5
	var xs: Array = []
	var bottom := b.position.y + b.size.y
	var y0 := bottom - maxi(4, int(b.size.y * 0.06))
	for y in range(y0, bottom, 2):
		for x in range(b.position.x, b.position.x + b.size.x, 2):
			if img.get_pixel(x, y).a >= 0.1:
				xs.append(x)
	if xs.is_empty():
		return float(b.position.x) + float(b.size.x) * 0.5
	xs.sort()
	return float(xs[floori(xs.size() * 0.5)])


## One crop rectangle and one scale for every idle frame AND every walk frame.
## Relative positions inside the sheet are untouched, so the painted step survives.
## Returns {"idle": [...], "walk": [...], "scale": float}.
static func _lock_direction(idle_imgs: Array, walk_imgs: Array, stature: int) -> Dictionary:
	var all: Array = []
	all.append_array(idle_imgs)
	all.append_array(walk_imgs)
	var union := Rect2i()
	var have := false
	for img in all:
		var b := _opaque_bounds(img as Image)
		if b.size.y < 1:
			continue
		union = b if not have else union.merge(b)
		have = true
	if not have:
		return {"idle": [], "walk": [], "scale": 1.0}

	var ref_h := _opaque_height(idle_imgs[0] as Image)
	var s := 1.0
	if ref_h >= 8:
		s = float(stature) / float(ref_h)
	var max_h := FRAME_H - FOOT_PAD
	if float(union.size.y) * s > float(max_h):
		s = float(max_h) / float(union.size.y)
	if float(union.size.x) * s > float(FRAME_W):
		s = float(FRAME_W) / float(union.size.x)
	var tw := maxi(1, int(round(float(union.size.x) * s)))
	var th := maxi(1, int(round(float(union.size.y) * s)))
	var anchor_x := _feet_anchor_x(idle_imgs[0] as Image)
	var ox := int(round(float(FRAME_W) * 0.5 - (anchor_x - float(union.position.x)) * s))
	if ox < 0 or ox + tw > FRAME_W:
		push_warning("NpcFrames: feet anchor pushes a direction outside the 256 px cell")
	var oy := max_h - th

	var idle_tex: Array = []
	for img in idle_imgs:
		idle_tex.append(_place(img as Image, union, tw, th, ox, oy))
	var walk_tex: Array = []
	for img in walk_imgs:
		walk_tex.append(_place(img as Image, union, tw, th, ox, oy))
	return {"idle": idle_tex, "walk": walk_tex, "scale": s}


static func _place(cell: Image, crop: Rect2i, tw: int, th: int, ox: int, oy: int) -> ImageTexture:
	var canvas := Image.create(FRAME_W, FRAME_H, false, Image.FORMAT_RGBA8)
	canvas.fill(Color(0, 0, 0, 0))
	var piece := cell.get_region(crop)
	if piece.get_width() != tw or piece.get_height() != th:
		piece.resize(tw, th, RESIZE_MODE)
	canvas.blit_rect(piece, Rect2i(0, 0, tw, th), Vector2i(ox, oy))
	canvas.generate_mipmaps()
	return ImageTexture.create_from_image(canvas)


static func _opaque_height(img: Image) -> int:
	var bounds := _opaque_bounds(img)
	return int(bounds.size.y)


static func _opaque_bounds(img: Image) -> Rect2i:
	if img == null or img.is_empty():
		return Rect2i()
	return img.get_used_rect()


static func _add_anim(frames: SpriteFrames, name: String, texs: Array, loop: bool, fps: float) -> void:
	if frames.has_animation(name):
		frames.remove_animation(name)
	frames.add_animation(name)
	frames.set_animation_loop(name, loop)
	frames.set_animation_speed(name, fps)
	for tex in texs:
		frames.add_frame(name, tex as Texture2D)
